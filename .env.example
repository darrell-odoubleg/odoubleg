PORT=3600
COOKIE_DOMAIN=mist.odoubleg.com

# Juniper Mist API token (MSP > API Tokens) and MSP UUID.
# Supports multiple MSP accounts (e.g. across separate Mist tenants):
# add MIST_API_TOKEN_2/MIST_MSP_ID_2, _3, etc.
MIST_API_TOKEN=
MIST_MSP_ID=

# Shared login credentials for the dashboard
APP_USERNAME=
APP_PASSWORD=

# Random secret for signing session cookies
SESSION_SECRET=
