# Copy to .env and fill in. Never commit .env.
SYNNEX_CUST=your-customer-number
SYNNEX_USER=your-xml-username
SYNNEX_PASS=your-xml-password
# Test first: https://testec.synnex.com/SynnexXML/PriceAvailability
SYNNEX_URL=https://ec.synnex.com/SynnexXML/PriceAvailability
# Where the selector page is hosted (or * on an internal network)
ALLOW_ORIGIN=*
CACHE_MINUTES=10
PORT=8787
# Secret path segment: the selector's proxy URL is https://<host>/k/<PROXY_KEY>
# Generate with: openssl rand -hex 16
PROXY_KEY=
HOST=127.0.0.1
